<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

  <!--
    Remoter light theme. Same keys as Dark.xaml, in the same order.
    If you add a key here, add it there in the same position, or a theme
    swap will throw at the first DynamicResource that cannot resolve.
  -->

  <!-- Surfaces -->
  <SolidColorBrush x:Key="Bg"                Color="#FFF3F4F6" po:Freeze="True" />
  <SolidColorBrush x:Key="Panel"             Color="#FFFFFFFF" po:Freeze="True" />
  <SolidColorBrush x:Key="PanelAlt"          Color="#FFECEEF1" po:Freeze="True" />
  <SolidColorBrush x:Key="Input"             Color="#FFFFFFFF" po:Freeze="True" />

  <!-- Lines -->
  <SolidColorBrush x:Key="Border"            Color="#FFE1E4E9" po:Freeze="True" />
  <SolidColorBrush x:Key="BorderStrong"      Color="#FFC7CCD4" po:Freeze="True" />

  <!-- Ink -->
  <SolidColorBrush x:Key="Text"              Color="#FF191C21" po:Freeze="True" />
  <SolidColorBrush x:Key="TextMuted"         Color="#FF5B6472" po:Freeze="True" />
  <SolidColorBrush x:Key="TextFaint"         Color="#FF666F7C" po:Freeze="True" />
  <SolidColorBrush x:Key="TextOnAccent"      Color="#FFFFFFFF" po:Freeze="True" />

  <!-- Light needs no accent split: #1D4FD0 clears AA as text on white and as a ground under white. -->
  <SolidColorBrush x:Key="Accent"            Color="#FF1D4FD0" po:Freeze="True" />
  <SolidColorBrush x:Key="AccentFill"        Color="#FF1D4FD0" po:Freeze="True" />
  <SolidColorBrush x:Key="AccentHover"       Color="#FF1A45B8" po:Freeze="True" />
  <SolidColorBrush x:Key="AccentPressed"     Color="#FF15379E" po:Freeze="True" />
  <SolidColorBrush x:Key="AccentSubtle"      Color="#1A1D4FD0" po:Freeze="True" />

  <!-- States -->
  <SolidColorBrush x:Key="Selection"         Color="#1F1D4FD0" po:Freeze="True" />
  <SolidColorBrush x:Key="SelectionInactive" Color="#175B6472" po:Freeze="True" />
  <SolidColorBrush x:Key="Hover"             Color="#0910141C" po:Freeze="True" />

  <!-- Semantic -->
  <SolidColorBrush x:Key="Danger"            Color="#FFBF2A21" po:Freeze="True" />
  <SolidColorBrush x:Key="DangerSubtle"      Color="#1ABF2A21" po:Freeze="True" />
  <SolidColorBrush x:Key="Warning"           Color="#FF9A6410" po:Freeze="True" />
  <SolidColorBrush x:Key="Success"           Color="#FF15754F" po:Freeze="True" />
  <SolidColorBrush x:Key="Favorite"          Color="#FF9C6A15" po:Freeze="True" />

</ResourceDictionary>
