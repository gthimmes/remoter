<Window x:Class="Remoter.App.EditConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connection settings" Height="560" Width="720" MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!--
      A rail, not a tab strip. Seven headers do not fit across this window, so they wrapped onto
      two rows with Experience, Security and Gateway landing above General. The rail holds all
      seven in order at any width, and the content scrolls between it and a fixed footer.

      Every section is built here and shown one at a time rather than swapped through a
      ContentControl, so each field keeps its name and the code-behind can reach it.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="172" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Section rail -->
        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource Bg}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Padding="8,12">
            <ListBox x:Name="Rail" Background="Transparent" BorderThickness="0" SelectedIndex="0"
                     ItemContainerStyle="{StaticResource RailItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="Rail_SelectionChanged">
                <ListBoxItem Content="General" />
                <ListBoxItem Content="Organize" />
                <ListBoxItem Content="Display" />
                <ListBoxItem Content="Local resources" />
                <ListBoxItem Content="Experience" />
                <ListBoxItem Content="Security" />
                <ListBoxItem Content="Gateway" />
            </ListBox>
        </Border>

        <!-- Content pane -->
        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource Panel}">
            <ScrollViewer x:Name="ContentScroller" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="26,22">
                <Grid>

                    <!-- General -->
                    <StackPanel x:Name="GeneralPanel">
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Connection name" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="NameBox" />
                        </StackPanel>

                        <!-- Computer and port share a row; a port never needs a full width. -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Computer" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="HostBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Width="96">
                                <TextBlock Text="Port" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="PortBox" />
                            </StackPanel>
                        </Grid>

                        <ContentControl Content="CREDENTIALS" Style="{StaticResource SectionHeading}" />

                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="User name" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="UserBox" />
                            <TextBlock Text="user, DOMAIN\user or user@domain" Style="{StaticResource Helper}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="PasswordBox" />
                        </StackPanel>

                        <CheckBox x:Name="SavePasswordBox" Content="Save this password" />
                        <TextBlock Text="Stored in Windows Credential Manager, never in the connection list or an exported .rdp file."
                                   Style="{StaticResource Helper}" Margin="25,4,0,0" />
                    </StackPanel>

                    <!-- Organize -->
                    <StackPanel x:Name="OrganizePanel" Visibility="Collapsed">
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Folder" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="FolderBox" />
                            <TextBlock Text="Use / to nest, for example Home/Servers" Style="{StaticResource Helper}" />
                        </StackPanel>

                        <CheckBox x:Name="FavoriteBox" Content="Favorite" Margin="0,0,0,16" />
                        <TextBlock Text="Favorites pin to the top of the list." Style="{StaticResource Helper}"
                                   Margin="25,-14,0,16" />

                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Tags" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="TagsBox" />
                            <TextBlock Text="Comma separated" Style="{StaticResource Helper}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="140"
                                     Padding="8,6" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Display -->
                    <StackPanel x:Name="DisplayPanel" Visibility="Collapsed">
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Remote desktop size" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="SizeModeBox">
                                <ComboBoxItem Content="Fit to window (resize the remote desktop)" />
                                <ComboBoxItem Content="Fixed size, scaled to fit (smart sizing)" />
                                <ComboBoxItem Content="Fixed size, with scrollbars" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel x:Name="FixedSizePanel" Orientation="Horizontal" Margin="0,0,0,16">
                            <StackPanel Width="110" Margin="0,0,12,0">
                                <TextBlock Text="Width" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="WidthBox" />
                            </StackPanel>
                            <StackPanel Width="110">
                                <TextBlock Text="Height" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="HeightBox" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Colors" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="ColorDepthBox">
                                <ComboBoxItem Content="High Color (15 bit)" Tag="15" />
                                <ComboBoxItem Content="High Color (16 bit)" Tag="16" />
                                <ComboBoxItem Content="True Color (24 bit)" Tag="24" />
                                <ComboBoxItem Content="Highest Quality (32 bit)" Tag="32" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Scale (DPI)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ScaleBox" Width="110" HorizontalAlignment="Left" />
                            <TextBlock Text="100 to 500. Leave blank to match this computer." Style="{StaticResource Helper}" />
                        </StackPanel>

                        <ContentControl Content="FULL SCREEN" Style="{StaticResource SectionHeading}" />
                        <CheckBox x:Name="FullScreenBox" Content="Start in full screen" />
                        <CheckBox x:Name="MultiMonBox" Content="Use all my monitors" />
                        <CheckBox x:Name="ConnectionBarBox" Content="Show the connection bar" />
                        <CheckBox x:Name="PinBarBox" Content="Pin the connection bar" />
                    </StackPanel>

                    <!-- Local resources -->
                    <StackPanel x:Name="LocalResourcesPanel" Visibility="Collapsed">
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Remote audio playback" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="AudioBox">
                                <ComboBoxItem Content="Play on this computer" />
                                <ComboBoxItem Content="Play on the remote computer" />
                                <ComboBoxItem Content="Do not play" />
                            </ComboBox>
                        </StackPanel>

                        <CheckBox x:Name="AudioCaptureBox" Content="Record audio from this computer (microphone)"
                                  Margin="0,0,0,16" />

                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Apply Windows key combinations" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="KeyboardBox">
                                <ComboBoxItem Content="On this computer" />
                                <ComboBoxItem Content="On the remote computer" />
                                <ComboBoxItem Content="Only when using full screen" />
                            </ComboBox>
                        </StackPanel>

                        <ContentControl Content="REDIRECT TO THE REMOTE COMPUTER" Style="{StaticResource SectionHeading}" />
                        <CheckBox x:Name="ClipboardBox" Content="Clipboard" />
                        <CheckBox x:Name="PrintersBox" Content="Printers" />
                        <CheckBox x:Name="SmartCardBox" Content="Smart cards and Windows Hello for Business" />
                        <CheckBox x:Name="PortsBox" Content="Ports (COM / LPT)" />
                        <CheckBox x:Name="DevicesBox" Content="Plug and play devices" />
                        <CheckBox x:Name="AllDrivesBox" Content="All drives" />
                        <CheckBox x:Name="DynamicDrivesBox" Content="Drives I plug in later" />
                    </StackPanel>

                    <!-- Experience -->
                    <StackPanel x:Name="ExperiencePanel" Visibility="Collapsed">
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Connection speed" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="SpeedBox" SelectionChanged="SpeedBox_SelectionChanged">
                                <ComboBoxItem Content="Detect connection quality automatically" Tag="7" />
                                <ComboBoxItem Content="Modem (56 kbps)" Tag="1" />
                                <ComboBoxItem Content="Low-speed broadband" Tag="2" />
                                <ComboBoxItem Content="Satellite" Tag="3" />
                                <ComboBoxItem Content="High-speed broadband" Tag="4" />
                                <ComboBoxItem Content="WAN" Tag="5" />
                                <ComboBoxItem Content="LAN (10 Mbps or higher)" Tag="6" />
                            </ComboBox>
                            <TextBlock Text="Sets the defaults below." Style="{StaticResource Helper}" />
                        </StackPanel>

                        <ContentControl Content="ALLOW THE FOLLOWING" Style="{StaticResource SectionHeading}" />
                        <CheckBox x:Name="WallpaperBox" Content="Desktop background" />
                        <CheckBox x:Name="FontSmoothingBox" Content="Font smoothing" />
                        <CheckBox x:Name="CompositionBox" Content="Desktop composition" />
                        <CheckBox x:Name="WindowDragBox" Content="Show window contents while dragging" />
                        <CheckBox x:Name="AnimationBox" Content="Menu and window animation" />
                        <CheckBox x:Name="ThemesBox" Content="Visual styles" />
                        <CheckBox x:Name="BitmapCacheBox" Content="Persistent bitmap caching" />

                        <ContentControl Content="CONNECTION" Style="{StaticResource SectionHeading}" />
                        <CheckBox x:Name="AutoReconnectBox" Content="Reconnect automatically if the connection is dropped" />
                    </StackPanel>

                    <!-- Security -->
                    <StackPanel x:Name="SecurityPanel" Visibility="Collapsed">
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="If server authentication fails" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="ServerAuthBox">
                                <ComboBoxItem Content="Warn me and let me connect" Tag="2" />
                                <ComboBoxItem Content="Connect and don't warn me" Tag="0" />
                                <ComboBoxItem Content="Do not connect" Tag="1" />
                            </ComboBox>
                        </StackPanel>

                        <CheckBox x:Name="NlaBox" Content="Use Network Level Authentication (recommended)" />
                        <TextBlock Style="{StaticResource Helper}" Margin="25,4,0,10"
                                   Text="Verifies your identity before a full session starts, and is the safe default over your home network. Turn it off only for older systems that do not support it." />

                        <CheckBox x:Name="RestrictedAdminBox" Content="Restricted Admin mode" />
                        <TextBlock Text="Does not send your credentials to the host." Style="{StaticResource Helper}"
                                   Margin="25,4,0,10" />

                        <CheckBox x:Name="CredGuardBox" Content="Remote Credential Guard" />
                        <TextBlock Text="Keeps your credentials on this computer." Style="{StaticResource Helper}"
                                   Margin="25,4,0,10" />

                        <CheckBox x:Name="AdminSessionBox" Content="Connect to the console / administrative session" />
                    </StackPanel>

                    <!-- Gateway -->
                    <StackPanel x:Name="GatewayPanel" Visibility="Collapsed">
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Remote Desktop Gateway" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="GatewayUsageBox" SelectionChanged="GatewayUsageBox_SelectionChanged">
                                <ComboBoxItem Content="Don't use a gateway" />
                                <ComboBoxItem Content="Always use a gateway" />
                                <ComboBoxItem Content="Detect automatically" />
                            </ComboBox>
                            <TextBlock Style="{StaticResource Helper}"
                                       Text="A gateway reaches a computer on a private network from outside without a VPN. Leave this off within your own home network." />
                        </StackPanel>

                        <StackPanel x:Name="GatewayDetails">
                            <StackPanel Style="{StaticResource Field}">
                                <TextBlock Text="Gateway server name" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="GatewayHostBox" />
                            </StackPanel>
                            <CheckBox x:Name="GatewaySameCredsBox" Content="Use my connection credentials for the gateway" />
                        </StackPanel>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="{DynamicResource Bg}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Cancel" Width="96" Style="{StaticResource SecondaryButton}"
                        Click="Cancel_Click" Margin="0,0,8,0" IsCancel="True" />
                <Button Content="Save" Width="110" Style="{StaticResource AccentButton}"
                        Click="Save_Click" IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
