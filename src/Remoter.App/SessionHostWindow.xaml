<Window x:Class="Remoter.App.SessionHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remoter sessions" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="Black">
    <Window.Resources>
        <!--
          Headers-only tab control. A normal TabControl swaps one ContentPresenter between tabs,
          which would tear down the hosted RDP window every time you switched and kill the session.
          The strip below selects; the live views all stay parented in SessionHost and take turns
          being visible.
        -->
        <Style x:Key="TabStrip" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SessionTabItem" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="Padding" Value="12,7,8,7" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <EventSetter Event="PreviewMouseDown" Handler="Tab_PreviewMouseDown" />
        </Style>

        <Style x:Key="TabCloseButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
            <Setter Property="ToolTip" Value="Close this session (Ctrl+W)" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tab strip + actions for the active session (all hidden in full screen) -->
        <Border x:Name="Chrome" Grid.Row="0" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Padding="6,4,0,0">
                    <TabControl x:Name="Tabs" Style="{StaticResource TabStrip}"
                                ItemContainerStyle="{StaticResource SessionTabItem}"
                                SelectionChanged="Tabs_SelectionChanged">
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                             ToolTip="{Binding StatusText}">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource TextFaint}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusKey}" Value="Connecting">
                                                        <Setter Property="Fill" Value="{DynamicResource Warning}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusKey}" Value="Connected">
                                                        <Setter Property="Fill" Value="{DynamicResource Success}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusKey}" Value="Reconnecting">
                                                        <Setter Property="Fill" Value="{DynamicResource Accent}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusKey}" Value="Failed">
                                                        <Setter Property="Fill" Value="{DynamicResource Danger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                               MaxWidth="180" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Address}" />
                                    <Button Content="&#x2715;" Style="{StaticResource TabCloseButton}"
                                            Margin="10,0,0,0" Click="TabClose_Click" />
                                </StackPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                    </TabControl>
                </ScrollViewer>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,6,12,6">
                    <Button Content="Full screen" Click="FullScreen_Click" Margin="0,0,6,0"
                            ToolTip="Show the active session full screen (F11)" />
                    <Button Content="Ctrl+Alt+Del" Click="Cad_Click" Margin="0,0,6,0" />
                    <Button Content="Fit now" Click="Fit_Click" Margin="0,0,6,0"
                            ToolTip="Match the remote resolution to this window" />
                    <Button Content="Disconnect" Click="Disconnect_Click"
                            ToolTip="Disconnect the active session and close its tab (Ctrl+W)" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Every live session lives here at once; only the selected one is visible. -->
        <Grid x:Name="SessionHost" Grid.Row="1" Background="Black" />

        <Border x:Name="StatusBar" Grid.Row="2" Background="{DynamicResource Panel}" Padding="12,5"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StateText" Grid.Column="0" Foreground="{DynamicResource TextMuted}"
                           FontSize="12" FontWeight="SemiBold" Margin="0,0,14,0" />
                <TextBlock x:Name="LogText" Grid.Column="1" Foreground="{DynamicResource TextFaint}" FontSize="12"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>
