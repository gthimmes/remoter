<Window x:Class="Remoter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remoter" Height="640" Width="920"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Quick connect with recents -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" Padding="18,16"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="QUICK CONNECT" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextFaint}" Margin="2,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Text box + recents caret share one rounded frame -->
                    <Border Grid.Column="0" Background="#2A2D33" CornerRadius="6" BorderThickness="1"
                            BorderBrush="{StaticResource Border}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="QuickHost" Grid.Column="0" BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" KeyDown="QuickHost_KeyDown"
                                     ToolTip="Computer name or address, e.g. desktop.home or 192.168.1.20:3389">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <ScrollViewer x:Name="PART_ContentHost" Margin="10,7" VerticalAlignment="Center" />
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                            <Button x:Name="RecentsButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                                    Click="RecentsButton_Click" ToolTip="Recent connections" Padding="10,0" Width="38">
                                <Path Data="M0,0 L4,4 L8,0 Z" Fill="{StaticResource TextMuted}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </Grid>
                    </Border>

                    <Button Grid.Column="1" Content="Connect" Style="{StaticResource AccentButton}"
                            Margin="10,0,0,0" MinWidth="110" Click="QuickConnect_Click" />

                    <Popup x:Name="RecentsPopup" PlacementTarget="{Binding ElementName=QuickHost}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide" HorizontalOffset="-1" VerticalOffset="6">
                        <Border Background="#24272D" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1"
                                CornerRadius="8" MinWidth="360" MaxHeight="360">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.5" Color="Black" />
                            </Border.Effect>
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Padding="14,10" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <TextBlock Text="Recent connections" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
                                        <Button Content="Clear" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                                Padding="8,2" FontSize="12" Click="ClearRecents_Click" />
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="RecentsEmpty" DockPanel.Dock="Bottom" Text="No recent connections yet."
                                           Foreground="{StaticResource TextFaint}" Margin="14,12" Visibility="Collapsed" />
                                <ListBox x:Name="RecentsList" Background="Transparent" BorderThickness="0" MaxHeight="300"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         MouseDoubleClick="RecentsList_MouseDoubleClick" Padding="6">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="10,8" />
                                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="b" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="b" Property="Background" Value="#31353D" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="b" Property="Background" Value="{StaticResource Selection}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Address}" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                                                <TextBlock Foreground="{StaticResource TextFaint}" FontSize="11" Margin="0,1,0,0">
                                                    <Run Text="{Binding Username, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Popup>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource Bg}" Padding="18,10"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="SAVED CONNECTIONS" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="New" Style="{StaticResource AccentButton}" Click="New_Click" Margin="0,0,8,0" />
                    <Button Content="Edit" Click="Edit_Click" Margin="0,0,6,0" />
                    <Button Content="Duplicate" Click="Duplicate_Click" Margin="0,0,6,0" />
                    <Button Content="Delete" Click="Delete_Click" Margin="0,0,6,0" />
                    <Border Width="1" Background="{StaticResource Border}" Margin="8,2" />
                    <Button Content="Import .rdp" Click="Import_Click" Margin="0,0,6,0" />
                    <Button Content="Export .rdp" Click="Export_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Saved connections -->
        <ListView x:Name="List" Grid.Row="2" Background="{StaticResource Bg}" BorderThickness="0"
                  Foreground="{StaticResource Text}" Margin="10,8"
                  MouseDoubleClick="List_MouseDoubleClick">
            <ListView.Resources>
                <Style TargetType="GridViewColumnHeader">
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="GridViewColumnHeader">
                                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                                        BorderThickness="0,0,1,1" Padding="12,8">
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="ListViewItem">
                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                    <Setter Property="Padding" Value="8,9" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource Selection}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#262930" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.Resources>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="230" DisplayMemberBinding="{Binding DisplayName}" />
                    <GridViewColumn Header="Computer" Width="230" DisplayMemberBinding="{Binding Host}" />
                    <GridViewColumn Header="User" Width="190" DisplayMemberBinding="{Binding QualifiedUsername}" />
                    <GridViewColumn Header="Last connected" Width="170" DisplayMemberBinding="{Binding LastConnected}" />
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="3" Background="{StaticResource Panel}" Padding="18,9"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="Status" Foreground="{StaticResource TextMuted}" Text="Ready." />
        </Border>
    </Grid>
</Window>
