<Window x:Class="Remoter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remoter" Height="620" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Quick connect -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Computer:" Margin="0,0,8,0" />
                <TextBox x:Name="QuickHost" Width="280" KeyDown="QuickHost_KeyDown"
                         ToolTip="Computer name or address, e.g. desktop.home or 192.168.1.20:3389" />
                <Button Content="Connect" Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                        Click="QuickConnect_Click" />
            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource Bg}" Padding="16,8" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="New" Click="New_Click" Margin="0,0,6,0" />
                <Button Content="Edit" Click="Edit_Click" Margin="0,0,6,0" />
                <Button Content="Duplicate" Click="Duplicate_Click" Margin="0,0,6,0" />
                <Button Content="Delete" Click="Delete_Click" Margin="0,0,6,0" />
                <Separator Margin="8,0" />
                <Button Content="Import .rdp" Click="Import_Click" Margin="0,0,6,0" />
                <Button Content="Export .rdp" Click="Export_Click" Margin="0,0,6,0" />
            </StackPanel>
        </Border>

        <!-- Saved connections -->
        <ListView x:Name="List" Grid.Row="2" Background="{StaticResource Bg}" BorderThickness="0"
                  Foreground="{StaticResource Text}" Margin="8"
                  MouseDoubleClick="List_MouseDoubleClick"
                  SelectionChanged="List_SelectionChanged">
            <ListView.Resources>
                <Style TargetType="GridViewColumnHeader">
                    <Setter Property="Background" Value="{StaticResource Panel}" />
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                    <Setter Property="Padding" Value="10,6" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                </Style>
                <Style TargetType="ListViewItem">
                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                    <Setter Property="Padding" Value="6,8" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentReal}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource PanelAlt}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.Resources>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="220" DisplayMemberBinding="{Binding DisplayName}" />
                    <GridViewColumn Header="Computer" Width="220" DisplayMemberBinding="{Binding Host}" />
                    <GridViewColumn Header="User" Width="180" DisplayMemberBinding="{Binding QualifiedUsername}" />
                    <GridViewColumn Header="Last connected" Width="160" DisplayMemberBinding="{Binding LastConnected}" />
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="3" Background="{StaticResource Panel}" Padding="16,8">
            <TextBlock x:Name="Status" Foreground="{StaticResource TextMuted}" Text="Ready." />
        </Border>
    </Grid>
</Window>
