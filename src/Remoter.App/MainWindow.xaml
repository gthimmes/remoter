<Window x:Class="Remoter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Remoter" Height="604" Width="960" MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen">
    <!--
      Custom caption. The OS title bar paints itself from the Windows theme, not ours, so it
      stayed light on a dark app. CaptionHeight matches the 40 DIP title bar below, which gives
      drag and double-click-to-maximise for free.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="56" />
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <ContentControl Style="{StaticResource AppMarkBadge}" Width="16" Height="16" />
                    <TextBlock Text="Remoter" Margin="10,0,0,0" FontSize="11" FontWeight="Medium"
                               Foreground="{DynamicResource TextMuted}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;"
                            Click="Minimize_Click" ToolTip="Minimise" AutomationProperties.Name="Minimise" />
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                            Click="MaximizeRestore_Click" ToolTip="Maximise" AutomationProperties.Name="Maximise" />
                    <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;"
                            Click="CloseWindow_Click" ToolTip="Close" AutomationProperties.Name="Close" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Quick connect -->
        <Border Grid.Row="1" Background="{DynamicResource Panel}" Padding="16,0"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="QUICK CONNECT" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFaint}" Margin="0,0,12,0" />

                <!-- Host box and its recents caret share one 300 DIP frame. -->
                <Border x:Name="QuickFrame" Width="300" Height="32" Background="{DynamicResource Input}"
                        CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource BorderStrong}"
                        Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="QuickHost" Grid.Column="0" BorderThickness="0" Background="Transparent"
                                 Height="30" VerticalContentAlignment="Center" KeyDown="QuickHost_KeyDown"
                                 ToolTip="Computer name or address, e.g. desktop.home or 192.168.1.20:3389">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost" Margin="10,0" VerticalAlignment="Center" />
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                        <Button x:Name="RecentsButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                                Click="RecentsButton_Click" ToolTip="Recent connections"
                                Height="30" Width="32" Padding="0">
                            <Path Data="M0,0 L4,4 L8,0 Z" Fill="{DynamicResource TextMuted}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <Button Content="Connect" Style="{StaticResource AccentButton}" Click="QuickConnect_Click" />

                <Popup x:Name="RecentsPopup" PlacementTarget="{Binding ElementName=QuickHost}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide" HorizontalOffset="-1" VerticalOffset="6">
                    <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                            CornerRadius="8" MinWidth="360" MaxHeight="360">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.5" Color="Black" />
                        </Border.Effect>
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="14,10" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <TextBlock Text="Recent connections" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                    <Button Content="Clear" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                            Padding="8,2" FontSize="12" Click="ClearRecents_Click" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="RecentsEmpty" DockPanel.Dock="Bottom" Text="No recent connections yet."
                                       Foreground="{DynamicResource TextFaint}" Margin="14,12" Visibility="Collapsed" />
                            <ListBox x:Name="RecentsList" Background="Transparent" BorderThickness="0" MaxHeight="300"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MouseDoubleClick="RecentsList_MouseDoubleClick" Padding="6">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="10,8" />
                                        <Setter Property="Foreground" Value="{DynamicResource Text}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="b" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="{DynamicResource PanelAlt}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Selection}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Address}" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                                            <TextBlock Foreground="{DynamicResource TextFaint}" FontSize="11" Margin="0,1,0,0">
                                                <Run Text="{Binding Username, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Popup>
            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="2" Background="{DynamicResource Bg}" Padding="16,0"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <!--
              Two columns rather than two overlaid panels: at the 960 DIP default the action
              group is wide enough to sit on top of the search box otherwise. The redundant
              SAVED CONNECTIONS label went with it; the column headers already say what this is.
            -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="240" Height="32" Background="{DynamicResource Input}" CornerRadius="6"
                            BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1">
                        <Grid>
                            <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" Height="30"
                                     VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <ScrollViewer x:Name="PART_ContentHost" Margin="10,0" VerticalAlignment="Center" />
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                            <TextBlock x:Name="SearchHint" Text="Search connections..." Foreground="{DynamicResource TextFaint}"
                                       Margin="11,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 4 DIP within a group, 12 between. One filled button on the window, and it is Connect. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="New" Style="{StaticResource TonalButton}" Click="New_Click" Margin="0,0,12,0" />
                    <Button x:Name="EditButton" Content="Edit" Click="Edit_Click" Margin="0,0,4,0" />
                    <Button x:Name="DuplicateButton" Content="Duplicate" Click="Duplicate_Click" Margin="0,0,4,0" />
                    <Button x:Name="DeleteButton" Content="Delete" Style="{StaticResource DangerButton}"
                            Click="Delete_Click" Margin="0,0,12,0" />
                    <Border Style="{StaticResource ToolbarDivider}" Margin="0,0,12,0" />
                    <Button Content="Import" Click="Import_Click" Margin="0,0,4,0" />
                    <Button x:Name="ExportButton" Content="Export" Click="Export_Click" Margin="0,0,12,0" />
                    <Border Style="{StaticResource ToolbarDivider}" Margin="0,0,12,0" />
                    <Button x:Name="ThemeButton" Content="Theme" Click="ThemeButton_Click"
                            ToolTip="Appearance: follow Windows, or pick dark or light" />

                    <Popup x:Name="ThemePopup" PlacementTarget="{Binding ElementName=ThemeButton}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide"
                           HorizontalOffset="-60" VerticalOffset="6">
                        <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource BorderStrong}"
                                BorderThickness="1" CornerRadius="8" MinWidth="200">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.5" Color="Black" />
                            </Border.Effect>
                            <StackPanel Margin="6">
                                <Button Style="{StaticResource GhostButton}" Click="ThemeChoice_Click" Tag="System"
                                        AutomationProperties.Name="System"
                                        HorizontalContentAlignment="Left" Padding="8,7">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TickSystem" Text="&#x2713;" Width="20"
                                                   Foreground="{DynamicResource Accent}" />
                                        <TextBlock Text="System" />
                                        <TextBlock x:Name="SystemHint" Margin="6,0,0,0"
                                                   Foreground="{DynamicResource TextFaint}" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Click="ThemeChoice_Click" Tag="Dark"
                                        AutomationProperties.Name="Dark"
                                        HorizontalContentAlignment="Left" Padding="8,7">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TickDark" Text="&#x2713;" Width="20"
                                                   Foreground="{DynamicResource Accent}" />
                                        <TextBlock Text="Dark" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Click="ThemeChoice_Click" Tag="Light"
                                        AutomationProperties.Name="Light"
                                        HorizontalContentAlignment="Left" Padding="8,7">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TickLight" Text="&#x2713;" Width="20"
                                                   Foreground="{DynamicResource Accent}" />
                                        <TextBlock Text="Light" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </Border>

        <!--
          Three ink levels and nothing else: Text for the name, TextMuted for data, TextFaint for
          the timestamp. On a selected row the faint cells promote a step, because faint ink does
          not hold up against the selection tint.
        -->
        <ListView x:Name="List" Grid.Row="3" Background="{DynamicResource Bg}" BorderThickness="0"
                  Foreground="{DynamicResource TextMuted}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  MouseDoubleClick="List_MouseDoubleClick">
            <ListView.Resources>
                <Style x:Key="Cell" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Margin" Value="12,0" />
                    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                </Style>
                <Style x:Key="NameCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
                    <Setter Property="Foreground" Value="{DynamicResource Text}" />
                    <Setter Property="FontWeight" Value="Medium" />
                </Style>
                <Style x:Key="FaintCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
                    <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
                    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}"
                                     Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.Resources>

            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="GroupItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GroupItem">
                                        <StackPanel>
                                            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                                                <ToggleButton x:Name="Toggle" IsChecked="True"
                                                              Style="{StaticResource GroupToggle}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path x:Name="Chevron" Data="M0,0 L4,4 L0,8" Width="5" Height="9"
                                                              Stroke="{DynamicResource TextFaint}" StrokeThickness="1.4"
                                                              VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                            <Path.RenderTransform>
                                                                <RotateTransform Angle="90" />
                                                            </Path.RenderTransform>
                                                        </Path>
                                                        <TextBlock Text="{Binding Name}" Margin="10,0,0,0" FontSize="12"
                                                                   FontWeight="Medium" Foreground="{DynamicResource TextMuted}" />
                                                        <Border Background="{DynamicResource PanelAlt}" CornerRadius="4"
                                                                Height="18" Padding="6,0" Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding ItemCount}" FontSize="11" FontWeight="Medium"
                                                                       Foreground="{DynamicResource TextFaint}" />
                                                        </Border>
                                                    </StackPanel>
                                                </ToggleButton>
                                            </Border>
                                            <ItemsPresenter x:Name="Items" />
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger SourceName="Toggle" Property="IsChecked" Value="False">
                                                <Setter TargetName="Items" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="0" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </ListView.GroupStyle>

            <ListView.View>
                <GridView>
                    <!-- Gutter. The favourite star, with room beside it for the live session dot. -->
                    <GridViewColumn Width="40">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="&#x2605;" FontSize="12" HorizontalAlignment="Center" Margin="0"
                                           Foreground="{DynamicResource Favorite}"
                                           Visibility="{Binding Favorite, Converter={StaticResource BoolToVisibility}}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Name" Width="220">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource NameCell}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Computer" Width="210">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Host}" Style="{StaticResource Cell}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="User" Width="170">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding QualifiedUsername}" Style="{StaticResource Cell}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!--
                      Tag pills. The hue comes from the tag text, so a tag looks the same in every
                      row; the converter returns an index and the triggers map it to a token, so a
                      theme swap still repaints them.
                    -->
                    <GridViewColumn Header="Tags" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Tags}" Margin="12,0" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="18" CornerRadius="4" Padding="6,0" Margin="0,0,4,0"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource Tag0Subtle}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Converter={StaticResource TagHue}}" Value="1">
                                                                <Setter Property="Background" Value="{DynamicResource Tag1Subtle}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Converter={StaticResource TagHue}}" Value="2">
                                                                <Setter Property="Background" Value="{DynamicResource Tag2Subtle}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Converter={StaticResource TagHue}}" Value="3">
                                                                <Setter Property="Background" Value="{DynamicResource Tag3Subtle}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding}" FontSize="11" FontWeight="Medium"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Foreground" Value="{DynamicResource Tag0}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Converter={StaticResource TagHue}}" Value="1">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Tag1}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Converter={StaticResource TagHue}}" Value="2">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Tag2}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Converter={StaticResource TagHue}}" Value="3">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Tag3}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Width is set in code so the last column takes up the slack. -->
                    <GridViewColumn x:Name="LastConnectedColumn" Header="Last connected" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LastConnected, StringFormat={}{0:g}}"
                                           Style="{StaticResource FaintCell}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Status bar -->
        <Border Grid.Row="4" Background="{DynamicResource Bg}" Padding="16,0"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="Status" FontSize="11" FontWeight="Medium"
                       Foreground="{DynamicResource TextFaint}" Text="Ready." />
        </Border>
    </Grid>
</Window>
