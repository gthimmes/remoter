<Window x:Class="Remoter.App.CredentialPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter your credentials" SizeToContent="Height" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border Background="{DynamicResource Panel}" CornerRadius="10" BorderBrush="{DynamicResource Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <StackPanel Margin="26,24,26,22">
            <TextBlock Text="Sign in" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
            <TextBlock x:Name="Prompt" TextWrapping="Wrap" Margin="0,6,0,20" Foreground="{DynamicResource TextMuted}"
                       Text="Enter your credentials for the remote computer." />

            <TextBlock Text="User name" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,0,0,4" />
            <TextBox x:Name="UserBox" Margin="0,0,0,14" />

            <TextBlock Text="Password" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,0,0,4" />
            <PasswordBox x:Name="PasswordBox" Margin="0,0,0,16" />

            <CheckBox x:Name="SaveBox" Content="Remember my password for this connection" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Cancel" Width="96" Style="{StaticResource SecondaryButton}"
                        Click="Cancel_Click" Margin="0,0,10,0" IsCancel="True" />
                <Button Content="Connect" Width="120" Style="{StaticResource AccentButton}"
                        Click="Ok_Click" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
