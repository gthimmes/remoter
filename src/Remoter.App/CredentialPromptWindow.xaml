<Window x:Class="Remoter.App.CredentialPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter your credentials" SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="Prompt" TextWrapping="Wrap" Margin="0,0,0,14"
                   Text="Enter your credentials for the remote computer." />

        <Label Content="User name" />
        <TextBox x:Name="UserBox" Margin="0,0,0,10" />

        <Label Content="Password" />
        <PasswordBox x:Name="PasswordBox" Margin="0,0,0,12" />

        <CheckBox x:Name="SaveBox" Content="Remember my password for this connection" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="90" Click="Cancel_Click" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Connect" Width="110" Style="{StaticResource AccentButton}"
                    Click="Ok_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
