<UserControl x:Class="Remoter.App.Views.SessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wf="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
             Background="Black">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
          Disconnect errors show here rather than in a message box: a modal dialog would freeze
          every other live session in the window until it was dismissed.
        -->
        <Border x:Name="Banner" Grid.Row="0" Background="{StaticResource DangerSubtle}" BorderBrush="{StaticResource Danger}"
                BorderThickness="0,0,0,1" Padding="16,10" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="BannerText" Grid.Column="0" Foreground="{StaticResource Text}"
                           TextWrapping="Wrap" Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Reconnect" Style="{StaticResource AccentButton}" Click="Reconnect_Click" Margin="0,0,8,0" />
                    <Button Content="Close tab" Click="CloseTab_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!--
          The hosted control paints white until a desktop arrives, which reads as a broken tab.
          It stays hidden (not collapsed, so it keeps its size) until there is something to show,
          and this placeholder sits behind it on the black ground.
        -->
        <Grid Grid.Row="1" Background="Black">
            <TextBlock x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource TextFaint}" FontSize="14" />
            <wf:WindowsFormsHost x:Name="Host" />
        </Grid>
    </Grid>
</UserControl>
